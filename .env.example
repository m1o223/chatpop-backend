NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://chatpop:REPLACE_ME@127.0.0.1:5432/chatpop
# Require verified TLS for remote production databases. Never use rejectUnauthorized=false.
DATABASE_SSL=false
DATABASE_CA_FILE=
DB_POOL_MAX=10
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ACCESS_TOKEN_SECONDS=900
SESSION_DAYS=30
CORS_ORIGINS=capacitor://localhost,http://localhost:5173
# Only configure proxy trust at your deployment edge; default does not trust X-Forwarded-For.
TRUST_PROXY=false
STORAGE_DRIVER=disabled
STORAGE_LOCAL_ROOT=.local/private-media
MAX_MEDIA_BYTES=104857600
# Test-only, must equal the exact local database name ending in _test.
ALLOW_TEST_DATABASE_RESET=
# Optional Docker Compose only (not read by the API):
POSTGRES_USER=chatpop
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_DB=chatpop
